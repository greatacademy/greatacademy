{
  "expo": {
    "name": "Great Academy",
    "slug": "greatacademy",
    "scheme": "greatacademy",
    "version": "0.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "ios": { "bundleIdentifier": "app.greatacademy", "supportsTablet": true },
    "android": {
      "package": "app.greatacademy",
      "adaptiveIcon": { "foregroundImage": "./assets/adaptive-icon.png", "backgroundColor": "#f9fafd" }
    },
    "plugins": ["expo-router"],
    "experiments": { "typedRoutes": true }
  }
}
