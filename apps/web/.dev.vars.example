# Local secrets for cf dev. Copy to .dev.vars; never commit .dev.vars.
BETTER_AUTH_SECRET="dev-only-secret-change-me-0123456789abcdef"
# Leave empty to log password-reset and verification links to the console.
RESEND_API_KEY=""
EMAIL_FROM=""
# Encrypts AI vendors' API keys in the database.
AI_KEYS_SECRET="dev-only-ai-keys-secret-change-me-0123456789"
# Stripe test keys; leave the key empty to keep billing off (docs/billing.md §10).
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# "on" once Alipay and WeChat Pay are turned on in the Stripe account.
STRIPE_WALLET=""
STRIPE_TAX=""
