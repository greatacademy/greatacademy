# Local secrets for cf dev. Copy to .dev.vars; never commit .dev.vars.
BETTER_AUTH_SECRET="dev-only-secret-change-me-0123456789abcdef"
# The email services to try in order: "resend", "cloudflare" (Cloudflare Email Service) or "cloudflare,resend".
# Empty uses Resend when its key is set, and with no key logs password-reset and verification links to the console.
EMAIL_PROVIDER=""
RESEND_API_KEY=""
EMAIL_FROM=""
# Encrypts AI vendors' API keys in the database.
AI_KEYS_SECRET="dev-only-ai-keys-secret-change-me-0123456789"
# Stripe test keys; leave the key empty to keep billing off (docs/billing.md §10).
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# "on" once Alipay and WeChat Pay are turned on in the Stripe account.
STRIPE_WALLET=""
STRIPE_TAX=""
# The App Store Connect in-app purchase key: its id, the issuer id and the .p8 file's text.
APPLE_IAP_KEY_ID=""
APPLE_IAP_ISSUER_ID=""
APPLE_IAP_KEY=""
