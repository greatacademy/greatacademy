# The API server's settings for `pnpm nx run server:dev`: copy to .env.local, which git ignores.
PORT=8080
# The site's origin. In development the web app's dev server proxies /api here, so the API's origin, API_URL, is the
# site's too and may be left out.
SITE_URL=http://localhost:5173
DATABASE_URL=postgres://postgres:postgres@localhost:54329/greatacademy
# Any long random string.
BETTER_AUTH_SECRET=
AI_KEYS_SECRET=
# Without a provider, emails are logged so their links can be followed. "cloudflare" needs CLOUDFLARE_ACCOUNT_ID and
# CLOUDFLARE_EMAIL_TOKEN; "resend" needs RESEND_API_KEY.
EMAIL_PROVIDER=
# Without R2 keys, guardians' forms are kept in memory.
CLOUDFLARE_ACCOUNT_ID=
# The voice service of compose.yaml (apps/voice/.env.example): `python -m ga_voice.devkeys` prints the private key.
VOICE_URL=
VOICE_TICKET_PRIVATE_KEY=
VOICE_SERVICE_CREDENTIAL=
