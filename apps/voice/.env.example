# Copy to .env.local (git-ignored), which compose.yaml reads for the voice service.
# Make a pair with `uv run python -m ga_voice.devkeys`; the private half goes to apps/web/.dev.vars.
VOICE_TICKET_PUBLIC_KEY=
# The credential the service presents to the web Worker.
VOICE_WORKER_CREDENTIAL=dev-voice-credential
# fake: scripted speech services for local development; unconfigured: refuse sessions.
VOICE_SPEECH=fake
