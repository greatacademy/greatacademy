{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "neverConnectToCloud": true,
  "analytics": false,
  "targetDefaults": {
    "build": { "dependsOn": ["^build"], "cache": true },
    "typecheck": { "dependsOn": ["^generate"], "cache": true },
    "test": { "dependsOn": ["^generate"], "cache": true },
    "lint": { "cache": true },
    "generate": { "cache": true }
  }
}
