# dependencies
node_modules/

# Nx
.nx/cache/
.nx/workspace-data/

# build outputs
dist/
coverage/
*.tsbuildinfo

# Cloudflare Workers (apps/web) and local settings (apps/server, apps/voice)
.cloudflare/
.env.local
.wrangler/
.tanstack/

# Copied from packages at build time (apps/web/vite.config.ts)
apps/web/public/embed/
apps/web/public/illustrations/
apps/web/public/audio/

# OS / editors
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# Originals of the illustrations, kept on the machine that made them (docs/english-illustrations.md, docs/chinese-illustrations.md)
content/english/illustrations/originals/
content/chinese/illustrations/originals/

# Recordings of the passages, made by tools/audio and uploaded to R2 (docs/content.md)
content/*/audio/files/

# The AI legal review lists compliance gaps; it stays on the owner's machine, out of this public repository.
legal-review/

# The vendors keys of deploy/k8s/secrets.py, kept on the machine that runs it
deploy/k8s/secrets.local.env
