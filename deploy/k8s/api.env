# The API server's settings that are not secret; the Secret api holds the rest (keys.py).
# The site, under whose /api the web Worker forwards the API to api.greatacademy.dev (ingress.yaml).
SITE_URL=https://greatacademy.dev
CLOUDFLARE_ACCOUNT_ID=92e0cc18d209112f5f86bfca122312b8
GUARDIAN_FORMS_BUCKET=ga-guardian-forms
# Cloudflare Email Service, with CLOUDFLARE_EMAIL_TOKEN in the Secret api.
EMAIL_PROVIDER=cloudflare
EMAIL_FROM=Great Academy <noreply@mail.greatacademy.dev>
# The voice service's WebSocket.
VOICE_URL=wss://voice.greatacademy.dev/v1/conversation
