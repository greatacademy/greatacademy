# The voice service's settings that are not secret; the Secret voice holds its credential (keys.py).
VOICE_CAPACITY=4
VOICE_LOG_LEVEL=info
# For each session the service asks the API for the speech services its routes name; sessions are refused with
# speech_unavailable while there is none.
VOICE_SPEECH=api
# The API in the namespace, for tutor turns and results, and the site, for recordings.
VOICE_API_URL=http://api:8080
VOICE_AUDIO_URL=https://greatacademy.dev
# The public half of the key the API signs tickets with: a raw Ed25519 key in base64url, written by secrets.py.
VOICE_TICKET_PUBLIC_KEY=53ajYvmLUklcXBNKBeTjdsFuF7XN2i06iEzcDExdwmU
