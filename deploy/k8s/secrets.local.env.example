# The vendors' keys of the API server, for keys.py: copy to secrets.local.env, which git ignores, fill in what you
# have, and run python3 deploy/k8s/keys.py. A key left empty keeps the value already in the Secret api.

# An account token with only Email Sending: Edit, made in the dashboard (README.md, Secrets).
CLOUDFLARE_EMAIL_TOKEN=
# An account token with Workers R2 Storage Bucket Item Read and Write on the bucket ga-guardian-forms only: its id,
# and the SHA-256 of its value in hex (README.md, Secrets).
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# A fallback email service, when EMAIL_PROVIDER in api.env names it.
RESEND_API_KEY=
# The Stripe account (docs/billing.md); its webhook is https://greatacademy.dev/api/stripe.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_WALLET=
STRIPE_TAX=
# The App Store Server API's in-app purchase key; notifications go to https://greatacademy.dev/api/apple. The key,
# PEM, may span lines inside double quotes.
APPLE_IAP_KEY_ID=
APPLE_IAP_ISSUER_ID=
APPLE_IAP_KEY=
